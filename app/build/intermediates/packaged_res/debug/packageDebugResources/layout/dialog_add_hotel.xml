<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/etHName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hotel name"
            android:inputType="textCapWords"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etHCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="City"
            android:inputType="textCapWords"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etHAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Address / area"
            android:inputType="textCapWords"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etHPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Price per night (₹)"
            android:inputType="number"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etHRooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Number of rooms available"
            android:inputType="number"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etHLat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Latitude (e.g. 23.0300)"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etHLng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Longitude (e.g. 72.5580)"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etHFacilities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Facilities, comma separated"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip: long-press the spot in Google Maps to read its latitude/longitude."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
